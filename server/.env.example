# MongoDB Atlas connection string
# Get this from: MongoDB Atlas → Database → Connect → Drivers → Connection String
MONGODB_URI=MongoDB-url

# Server port (Railway sets PORT automatically)
PORT=3001

# JWT secret — generate a random 64-char string
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=randomBytes

# Max payload size in MB (default 8MB — covers ~5000 notes)
MAX_PAYLOAD_MB=8
